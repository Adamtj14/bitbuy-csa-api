# Deploy secrets shared by every project. Copy to ~/.config/platform/secrets.env
# and fill in. `new-project` loads this and sets each value as a repo secret on
# the new project, so you configure them once and never touch per-repo secrets
# by hand.
#
#   mkdir -p ~/.config/platform
#   cp platform/bin/secrets.env.example ~/.config/platform/secrets.env
#   chmod 600 ~/.config/platform/secrets.env   # keep it private
#
# Do NOT commit the filled-in file anywhere.

# --- VPS SSH access (used by the deploy step) ---
VPS_HOST=72.60.127.52
VPS_USER=root
# Paste the PRIVATE key that matches a public key in the VPS's authorized_keys.
# For a multi-line key, keep it on one line with \n, or set it later with:
#   gh secret set VPS_SSH_KEY --repo OWNER/REPO < path/to/id_ed25519
VPS_SSH_KEY=
VPS_PORT=22
# Public IPv4 for the DNS A record (often the same as VPS_HOST).
VPS_PUBLIC_IP=72.60.127.52

# --- Hostinger DNS API (used to upsert the subdomain record) ---
# hPanel -> Profile -> Account Information -> API
HOSTINGER_API_TOKEN=
